# wn library data (downloaded wordnets + sqlite db) and large source XML
.wn_data/
*.xml
*.xml.xz

# downloaded mapping tables and generated candidate dumps
*.tab
*.tsv
# hand-made inputs, not dumps
!sensebank/relink.tsv
!sensebank/top100_review.tsv

# literate-programming weave intermediates (figures are embedded in the output)
*.weave.md
*.weave-pdf.md
*.weave-css.html
*-fig[0-9]*.svg
*-fig[0-9]*.png

# editor lock / autosave artifacts
\#*\#
.\#*
*~

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb

# compiled PDFs live under docs/pdf/ (published); latex/ holds only sources
latex/**/*.pdf

# downloaded ARASAAC template and generated pictograms (outputs, not source)
images/*.png

# sensebank: LINDAT downloads (CC BY-NC-SA) and outputs, the built report
# (published as docs/pdf/sensebank-report.pdf), and a paper we may not share
sensebank/data/
sensebank/report/*.pdf
sensebank/papers/bejcek-etal-2006-tsd.pdf

# Python caches
__pycache__/
.pytest_cache/

# AUCTeX style cache
auto/
